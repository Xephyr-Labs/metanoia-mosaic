{
  "name": "metanoia-mosaic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:example": "npm run dev -w @metanoia/example-express",
    "clean": "rm -rf packages/*/dist examples/*/dist",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
